<resources>
    <style name="Theme.CampBoardGameHost" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <!-- Bars are hidden in immersive mode; make them transparent for the
             brief transient-reveal moment so no colour flash appears. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
